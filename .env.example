# Carpeta de Windows donde se guardan los videos (barras normales). Si se omite: ./projects
EVERGREEN_PROJECTS_DIR=D:/Videos

# Claves de API: solo los nombres; nunca subas el .env real
# Clave de Google AI Studio. Vacía = el guion se hace a mano (modo manual).
GEMINI_API_KEY=

# Cloudflare Workers AI (imágenes gratis). Vacío = las imágenes se hacen a mano.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Opcionales (descomenta para cambiarlos)
# EVERGREEN_VOICE_MODE=piper   (gemini | piper | manual; sin esto: gemini si hay clave, si no manual)
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# PIPER_VOICE=es_ES-davefx-medium
# EVERGREEN_IMAGE_MODE=manual   (cloudflare | manual; sin esto: cloudflare si hay credenciales)
# GEMINI_MODEL=gemini-3.5-flash-lite
# EVERGREEN_SCRIPT_MODE=manual
# EVERGREEN_SIMILARITY_THRESHOLD=0.35
